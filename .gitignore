# 산출물·임시 (렌더 결과 HTML은 올리지 않는다 — md가 원본)
*.html
!skills/**/examples/*.html
!loops/**/*.html
# 템플릿 원본(회사소개서 마스터)은 산출물이 아니다
!templates/**/*.html
bids/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# 절대 올리지 않는 것 — 키·주소·시크릿
*.pem
*.key
.env
.env.*
*.secret

# npx skills add 가 현재 폴더에 떨구는 것 — install.sh 는 $HOME 에서 돌리지만 실수 방지
.agents/
.claude/
skills-lock.json
